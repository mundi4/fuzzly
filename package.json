{
  "name": "fuzzly",
  "version": "1.0.0",
  "type": "module",
  "description": "커맨트팔레트 용 그냥대충 애매하게 한글 매칭",
  "exports": {
    ".": "./src/index.ts",
    "./score": "./src/score.ts",
    "./react": "./src/react/index.ts"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/score.ts src/react/index.ts --dts --format esm,cjs,iife --global-name fuzzly",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint",
    "ci": "biome ci"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
